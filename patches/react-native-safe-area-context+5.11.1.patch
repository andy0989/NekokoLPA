+UIEdgeInsets RNCInsetsAvoidingDivisions(UIView *view, UIEdgeInsets insets)
+{
+#if defined(__IPHONE_27_1) && __IPHONE_OS_VERSION_MAX_ALLOWED >= __IPHONE_27_1
+  if (@available(iOS 27.1, tvOS 27.1, visionOS 27.1, *)) {
+    CGRect bounds = view.bounds;
+    CGRect usable = UIEdgeInsetsInsetRect(bounds, insets);
+    for (UIViewReservedRegion *region in [view reservedRegionsOfKind:UIViewReservedRegionKind.divisionRegionKind]) {
+      CGRect division = CGRectIntersection(usable, region.frame);
+      if (CGRectIsEmpty(division) || CGRectIsNull(division)) {
+        continue;
+      }
+      // Match an overlay arrangement: controls occupy the trailing or bottom
+      // pane. The region includes the interactive margins around the fold.
+      CGRect candidates[] = {
+          CGRectMake(CGRectGetMinX(usable), CGRectGetMinY(usable),
+                     CGRectGetMinX(division) - CGRectGetMinX(usable), CGRectGetHeight(usable)),
+          CGRectMake(CGRectGetMinX(usable), CGRectGetMinY(usable),
+                     CGRectGetWidth(usable), CGRectGetMinY(division) - CGRectGetMinY(usable)),
+          CGRectMake(CGRectGetMaxX(division), CGRectGetMinY(usable),
+                     CGRectGetMaxX(usable) - CGRectGetMaxX(division), CGRectGetHeight(usable)),
+          CGRectMake(CGRectGetMinX(usable), CGRectGetMaxY(division),
+                     CGRectGetWidth(usable), CGRectGetMaxY(usable) - CGRectGetMaxY(division)),
+      };
+      NSUInteger preferred = CGRectGetHeight(region.frame) >= CGRectGetWidth(region.frame)
+          ? (view.effectiveUserInterfaceLayoutDirection == UIUserInterfaceLayoutDirectionRightToLeft ? 0 : 2)
+          : 3;
+      if (!CGRectIsEmpty(candidates[preferred])) {
+        usable = candidates[preferred];
+        continue;
+      }
+      CGFloat largestArea = 0;
+      for (NSUInteger index = 0; index < 4; index++) {
+        CGRect candidate = candidates[index];
+        CGFloat area = CGRectGetWidth(candidate) * CGRectGetHeight(candidate);
+        if (area > 0 && area >= largestArea) {
+          largestArea = area;
+          usable = candidate;
+        }
+      }
+      if (largestArea == 0) {
+        usable = CGRectMake(CGRectGetMaxX(usable), CGRectGetMaxY(usable), 0, 0);
+      }
+    }
+    return UIEdgeInsetsMake(CGRectGetMinY(usable) - CGRectGetMinY(bounds),
+                            CGRectGetMinX(usable) - CGRectGetMinX(bounds),
+                            CGRectGetMaxY(bounds) - CGRectGetMaxY(usable),
+                            CGRectGetMaxX(bounds) - CGRectGetMaxX(usable));
+  }
+#endif
+  return insets;
+}
